# Copia este archivo como .env.local y rellena los valores reales.
# .env.local no se commitea (cubierto por *.local en .gitignore).

# Supabase del CRM Cosiris — anon key, diseñada para ser pública en el
# navegador (protegida por RLS del lado de Supabase, no es un secreto).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL base del CRM (donde vive /api/public/portal-lead). En local, el CRM
# corre en localhost:3000 por defecto — solo hace falta definir esto para
# producción, donde el dominio del CRM será distinto.
VITE_CRM_API_URL=http://localhost:3000

# Google Maps — API key para Static Maps API (mapas estáticos como imagen).
# Se usa en lugar de Leaflet/OpenStreetMap en el portal inmobiliario.
VITE_GOOGLE_MAPS_KEY=tu-api-key
